# Copy these into Vercel: Project > Settings > Environment Variables.
# From console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# From Supabase > Project Settings > API (or added for you by the Vercel Supabase integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only these emails may use the office (comma separated). Leave empty to let anyone sign up.
ALLOWED_EMAILS=
# Optional: Claude calls per person per day (default 60).
DAILY_CLAUDE_CALLS=60
