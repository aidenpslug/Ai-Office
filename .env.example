# Copy these into Vercel: Project > Settings > Environment Variables.
# From console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# From Supabase > Project Settings > API (or added for you by the Vercel Supabase integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: your email, to lock in the owner. Otherwise the first person to sign in becomes the owner.
OWNER_EMAIL=
# Optional: Jarvis commands per person per day (default 100). Tickets per month are set in Account > People.
DAILY_JARVIS_CALLS=100
